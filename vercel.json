{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "has": [{ "type": "host", "value": "portal.agentiva.com.ar" }],
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "portal.agentiva.com.ar" }],
      "destination": "/portal/$1"
    }
  ]
}
